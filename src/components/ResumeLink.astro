---
import { profile, withBase } from '../lib/site';
import Icon from './Icon.astro';
interface Props { download?: boolean; }
const { download = false } = Astro.props;
---
{download ? (
  profile.resumePath ? <a class="link-button link-button--solid" href={withBase(profile.resumePath)} download>Download Resume<Icon /></a>
    : <span class="resume-pending">PDF coming soon</span>
) : <a class="external-link" href={withBase('/resume/')}>Resume<Icon /></a>}
