---
import illustration from '../../public/images/next-chapter-workflow.svg?raw';
---
<div class="workflow-illustration" data-workflow-illustration data-project-image="next-chapter" style="view-transition-name: project-next-chapter">
  <Fragment set:html={illustration} />
</div>
<style>
  .workflow-illustration { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; min-height: 0; }
  .workflow-illustration :global(svg) { display: block; width: 100%; height: 100%; max-height: 100%; filter: drop-shadow(0 3px 7px #27332e12); }
</style>
