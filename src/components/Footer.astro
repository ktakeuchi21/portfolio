---
import ExternalLink from './ExternalLink.astro';
import { profile, withBase } from '../lib/site';
---
<footer class="site-footer page-width">
  <div class="footer-main">
    <div><a class="footer-name" href={withBase('/')}>Kai Takeuchi</a></div>
    <nav aria-label="Connect"><ExternalLink href={profile.linkedin}>LinkedIn</ExternalLink><ExternalLink href={profile.github}>GitHub</ExternalLink></nav>
  </div>
  <div class="footer-meta"><span>© {new Date().getFullYear()} Kai Takeuchi</span></div>
</footer>
