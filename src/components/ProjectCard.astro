---
import type { CollectionEntry } from 'astro:content';
import Tag from './Tag.astro';
import LinkButton from './LinkButton.astro';
import ExternalLink from './ExternalLink.astro';
import Icon from './Icon.astro';
import ProjectVisual from './ProjectVisual.astro';
import { caseStudyPath, projectStatuses } from '../lib/content';
import { externalLinkAttributes, withBase } from '../lib/site';
interface Props { entry: CollectionEntry<'projects'>; headingLevel?: 'h2' | 'h3'; interactiveImage?: boolean; }
const { entry, headingLevel: Heading = 'h3', interactiveImage = false } = Astro.props;
const { title, summary, image, tags, liveDemo, github, slug, status, category } = entry.data;
const caseStudy = caseStudyPath(entry);
const primary = caseStudy || liveDemo || github;
const imageLink = interactiveImage && primary ? primary : undefined;
const ImageFrame = imageLink ? 'a' : 'div';
---
<article class:list={['project-card', `project-card--${slug}`, { 'project-card--text': !image }]} data-project={slug} data-category={category}>
  {image && !entry.data.draft ? <ProjectVisual entry={entry} /> : image && <ImageFrame class:list={['project-image', { 'project-image--interactive': imageLink }]} href={imageLink ? withBase(imageLink) : undefined} {...(imageLink ? externalLinkAttributes(imageLink, Astro.site ?? Astro.url) : {})} aria-label={imageLink ? `Explore ${title}` : undefined} draggable={imageLink ? false : undefined}>
    <img src={withBase(image.src)} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" draggable={imageLink ? false : undefined} />
    {imageLink && <span class="project-preview-cue" aria-hidden="true">Explore project <Icon kind="arrow" /></span>}
  </ImageFrame>}
  <div class="project-copy">
    <div class="project-heading">
      <Heading class="card-title">{primary ? <a href={withBase(primary)} {...externalLinkAttributes(primary, Astro.site ?? Astro.url)}>{title}</a> : title}</Heading>
      <p class="project-status">{projectStatuses[status]}</p>
    </div>
    <div class="project-detail">
    <p class="project-summary">{summary}</p>
    <div class="tags">{tags.map(tag => <Tag>{tag}</Tag>)}</div>
    <div class="project-actions">
      {caseStudy ? <LinkButton href={caseStudy} external={caseStudy.startsWith('https:')}>Case study</LinkButton> : <span class="forthcoming">Case study forthcoming</span>}
      {liveDemo && <ExternalLink href={liveDemo}>{slug === 'what-i-made' ? 'Public sample' : 'Live demo'}</ExternalLink>}
      {github && <ExternalLink href={github}>GitHub</ExternalLink>}
    </div>
    </div>
  </div>
</article>
