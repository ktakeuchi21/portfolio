---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import { learningResources } from '../../data/learning';
interface Props { variant: 'analog' | 'editorial' | 'gallery' | 'playlist'; }
const { variant } = Astro.props;
// Keep the original five-show explorations available as their initial comparison.
const podcasts = learningResources.filter(item => item.kind === 'podcast').slice(0, 5);
const count = String(podcasts.length).padStart(2, '0');
const initial = podcasts[0];
---
<div class:list={['podcast-mock', variant]} data-mock={variant} role="group" aria-label={`${variant} podcast browsing preview`}>
  <div class="mock-heading">
    <p>What I tune into.</p>
    <span class="collection-label">{variant === 'analog' ? 'Personal frequencies' : variant === 'gallery' ? 'The listening collection' : 'On rotation'} <span aria-hidden="true">/</span> {count}</span>
  </div>
  <div class="feature">
    <div class="art-stage" data-swipe>
      {podcasts.map((podcast, index) => variant === 'gallery' ?
        <button class="cover" type="button" data-pick={index} data-art={index} data-title={podcast.title} data-creator={podcast.creator} data-href={podcast.href} aria-label={`Select ${podcast.title}`} aria-pressed={index === 0 ? 'true' : 'false'} style={`--offset:${index > 2 ? index - 5 : index}; --depth:${5 - Math.abs(index > 2 ? index - 5 : index)}`}>
          <Image src={podcast.image} alt={`${podcast.title} podcast artwork`} width={320} widths={[220, 320, 640]} sizes="(max-width: 640px) 180px, 260px" format="webp" quality={90} loading="lazy" decoding="async" />
        </button> :
        <div class="cover" data-art={index} data-title={podcast.title} data-creator={podcast.creator} data-href={podcast.href} hidden={index !== 0}>
          <Image src={podcast.image} alt={`${podcast.title} podcast artwork`} width={320} widths={[220, 320, 640]} sizes={variant === 'editorial' ? '(max-width: 640px) 240px, 320px' : '(max-width: 640px) 180px, 220px'} format="webp" quality={90} loading="lazy" decoding="async" />
        </div>
      )}
    </div>
    <div class="information">
      <div class="show-metadata" aria-live="polite" aria-atomic="true">
        <div class="show-label"><span>{variant === 'analog' ? 'Selected frequency' : 'From my rotation'}</span><span data-counter>01 / {count}</span></div>
        <h3 data-title-display>{initial.title}</h3>
        <p data-creator-display>{initial.creator}</p>
      </div>
      <a class="open-link" data-open href={initial.href} target="_blank" rel="noopener noreferrer" aria-label={`Open ${initial.title} on Apple Podcasts`}>Open podcast <Icon kind="external" /></a>
    </div>
    <div class="transport" aria-label="Browse podcasts">
      <button class="skip" type="button" data-step="-1" aria-label="Previous podcast"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m14 5-7 7 7 7" /></svg></button>
      <span class="transport-label">Tune</span>
      <button class="skip" type="button" data-step="1" aria-label="Next podcast"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m10 5 7 7-7 7" /></svg></button>
    </div>
  </div>
  <div class="selector-area">
    {variant === 'playlist' && <div class="queue-heading"><span>My rotation</span><span>{count} shows</span></div>}
    <div class="selectors" role="group" aria-label="Choose a podcast">
      {podcasts.map((podcast, index) => <button class="selector" type="button" data-pick={index} aria-label={`Select ${podcast.title}`} aria-pressed={index === 0 ? 'true' : 'false'}>
        <span class="preset-number">{String(index + 1).padStart(2, '0')}</span>
        <Image src={podcast.image} alt={`${podcast.title} podcast artwork`} width={64} widths={[64, 128]} sizes="48px" format="webp" quality={90} loading="lazy" decoding="async" />
        <span class="selector-text"><span class="selector-title">{podcast.title}</span><span class="selector-creator">{podcast.creator}</span></span>
        <span class="selection-mark" aria-hidden="true"><i></i><i></i><i></i></span>
      </button>)}
    </div>
  </div>
  <div class="mock-footer"><span>{variant === 'analog' ? 'Five favorites. Always in rotation.' : variant === 'gallery' ? 'Swipe to explore the collection' : 'A few familiar voices.'}</span><span class="loop-note"><span aria-hidden="true">↻</span> {variant === 'analog' ? 'Continuous tuning' : 'Keep exploring'}</span></div>
  <noscript><p class="no-script">Browse the collection: {podcasts.map((podcast, index) => <><a href={podcast.href} target="_blank" rel="noopener noreferrer">{podcast.title}</a>{index < podcasts.length - 1 ? ' · ' : ''}</>)}</p></noscript>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-mock]').forEach(mock => {
    const arts = [...mock.querySelectorAll<HTMLElement>('[data-art]')];
    const picks = [...mock.querySelectorAll<HTMLButtonElement>('[data-pick]')];
    const stage = mock.querySelector<HTMLElement>('[data-swipe]')!;
    const link = mock.querySelector<HTMLAnchorElement>('[data-open]')!;
    const gallery = mock.dataset.mock === 'gallery';
    let selected = 0;
    let origin: { x: number; y: number } | undefined;
    let suppressClick = false;
    let wheelLocked = false;
    const select = (value: number) => {
      selected = (value + arts.length) % arts.length;
      const current = arts[selected];
      picks.forEach(pick => pick.setAttribute('aria-pressed', String(Number(pick.dataset.pick) === selected)));
      arts.forEach((art, index) => {
        if (gallery) {
          let offset = (index - selected + arts.length) % arts.length;
          if (offset > Math.floor(arts.length / 2)) offset -= arts.length;
          art.style.setProperty('--offset', String(offset));
          art.style.setProperty('--depth', String(arts.length - Math.abs(offset)));
        } else art.hidden = index !== selected;
      });
      mock.querySelector<HTMLElement>('[data-title-display]')!.textContent = current.dataset.title!;
      mock.querySelector<HTMLElement>('[data-creator-display]')!.textContent = current.dataset.creator!;
      mock.querySelector<HTMLElement>('[data-counter]')!.textContent = `${String(selected + 1).padStart(2, '0')} / ${String(arts.length).padStart(2, '0')}`;
      link.href = current.dataset.href!;
      link.setAttribute('aria-label', `Open ${current.dataset.title} on Apple Podcasts`);
    };
    mock.querySelectorAll<HTMLButtonElement>('[data-step]').forEach(button => button.addEventListener('click', () => select(selected + Number(button.dataset.step))));
    picks.forEach(pick => pick.addEventListener('click', event => {
      if (suppressClick) { event.preventDefault(); suppressClick = false; return; }
      select(Number(pick.dataset.pick));
    }));
    if (gallery) arts.forEach(art => art.addEventListener('focus', () => select(Number(art.dataset.art))));
    mock.addEventListener('keydown', event => {
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      select(event.key === 'Home' ? 0 : event.key === 'End' ? arts.length - 1 : selected + (event.key === 'ArrowRight' ? 1 : -1));
      // Preserve the focused kind of selector, including the gallery's cover buttons.
      const focused = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-pick]');
      if (focused) {
        const group = focused.parentElement!;
        const next = group.querySelector<HTMLButtonElement>(`[data-pick="${selected}"]`);
        next?.focus({ preventScroll: true });
        if (!gallery) next?.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'instant' });
      }
    });
    stage.addEventListener('pointerdown', event => {
      if (event.button !== 0) return;
      origin = { x: event.clientX, y: event.clientY };
      suppressClick = false;
    });
    stage.addEventListener('pointermove', event => {
      if (origin && event.pointerType === 'mouse' && Math.abs(event.clientX - origin.x) > 8) stage.setPointerCapture(event.pointerId);
    });
    stage.addEventListener('pointerup', event => {
      if (!origin) return;
      const dx = event.clientX - origin.x;
      const dy = event.clientY - origin.y;
      if (Math.abs(dx) > 36 && Math.abs(dx) > Math.abs(dy)) {
        select(selected + (dx < 0 ? 1 : -1));
        suppressClick = true;
        setTimeout(() => { suppressClick = false; }, 0);
      }
      origin = undefined;
    });
    stage.addEventListener('pointercancel', () => { origin = undefined; });
    stage.addEventListener('dragstart', event => event.preventDefault());
    stage.addEventListener('wheel', event => {
      if (Math.abs(event.deltaX) <= Math.abs(event.deltaY) || Math.abs(event.deltaX) < 8) return;
      event.preventDefault();
      if (wheelLocked) return;
      select(selected + (event.deltaX > 0 ? 1 : -1));
      wheelLocked = true;
      setTimeout(() => { wheelLocked = false; }, 350);
    }, { passive: false });
  });
</script>

<style>
  .podcast-mock { --local-muted: #657065; --local-line: #d6dbd1; color: var(--color-ink); }
  .podcast-mock [hidden] { display: none; }
  .podcast-mock button { cursor: pointer; font: inherit; color: inherit; }
  .podcast-mock button:focus-visible, .podcast-mock a:focus-visible { outline: 2px solid currentColor; outline-offset: 5px; }
  .mock-heading { display: flex; justify-content: space-between; align-items: center; gap: 20px; }
  .mock-heading > p { font: 400 2rem/1.2 var(--font-display); letter-spacing: -.025em; }
  .collection-label { color: var(--local-muted); font-size: .625rem; letter-spacing: .12em; text-transform: uppercase; }
  .collection-label > span { padding-inline: 8px; }
  .art-stage { position: relative; touch-action: pan-y; user-select: none; }
  .cover :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .show-label { display: flex; align-items: center; gap: 18px; color: var(--local-muted); font-size: .6rem; letter-spacing: .12em; text-transform: uppercase; }
  [data-counter] { white-space: nowrap; font-variant-numeric: tabular-nums; }
  h3 { font: 400 2.8rem/1.05 var(--font-display); letter-spacing: -.035em; margin-top: 16px; text-wrap: initial; }
  [data-creator-display] { color: var(--local-muted); font-size: .8125rem; margin-top: 10px; }
  .open-link { display: inline-flex; align-items: center; justify-content: center; gap: 14px; min-height: 44px; font-size: .75rem; margin-top: 24px; }
  .open-link:hover { text-decoration: underline; }
  .open-link :global(svg) { width: 15px; height: 15px; }
  .transport { display: flex; gap: 12px; align-items: center; }
  .skip { display: grid; place-items: center; width: 48px; height: 48px; flex-shrink: 0; border: 1px solid var(--local-line); border-radius: 50%; background: transparent; transition: background 180ms ease, transform 180ms ease; }
  .skip:hover { background: #27332e0a; transform: translateY(-2px); }
  .transport-label { display: none; }
  .selectors { display: flex; }
  .selector { display: flex; align-items: center; min-width: 0; min-height: 48px; text-align: left; }
  .selector :global(img) { width: 48px; height: 48px; object-fit: cover; flex-shrink: 0; }
  .preset-number { font-size: .6875rem; font-variant-numeric: tabular-nums; color: var(--local-muted); }
  .selector-title { display: block; font-size: .75rem; line-height: 1.35; }
  .selector-creator { display: none; }
  .selection-mark { display: none; align-items: center; gap: 2px; height: 14px; }
  .selection-mark i { width: 2px; height: 7px; background: currentColor; }
  .selection-mark i:nth-child(2) { height: 13px; }
  .selection-mark i:last-child { height: 10px; }
  .mock-footer { display: flex; justify-content: space-between; align-items: center; gap: 16px; color: var(--local-muted); font-size: .6rem; letter-spacing: .025em; }
  .loop-note { white-space: nowrap; }
  .loop-note > span { font-size: 17px; padding-right: 4px; vertical-align: -1px; }
  .no-script { font-size: .8rem; margin-top: 20px; }
  .no-script a { text-decoration: underline; }

  /* 01. A furniture-like enclosure, matte face, and mechanical station presets. */
  .analog { --local-muted: #706958; --local-line: #c9c5b6; border: 12px solid transparent; border-radius: 16px; padding: 28px 32px 18px; background: linear-gradient(135deg, #f1efdf, #e5e3d6) padding-box, repeating-linear-gradient(3deg, #654733 0px, #77543d 2px, #70503a 4px, #835f45 8px) border-box; box-shadow: 0 3px 0 #4f3929, 0 16px 28px -23px #3c2b1be0, inset 0 1px 2px #fff; }
  .analog .mock-heading { padding-bottom: 24px; border-bottom: 1px solid #c8c6b7; }
  .analog .mock-heading > p { font-size: 1.65rem; }
  .analog .feature { display: grid; grid-template-columns: 200px minmax(0, 1fr) 60px; gap: 36px; align-items: center; padding-block: 32px; }
  .analog .art-stage { padding: 8px; background: #41463b; box-shadow: inset 0 2px 5px #0004, 0 1px 0 #fff; border-radius: 5px; }
  .analog .cover { aspect-ratio: 1; overflow: hidden; border-radius: 2px; }
  .analog .show-label > :first-child::before { content: ''; display: inline-block; width: 5px; height: 5px; margin-right: 8px; background: #587545; border-radius: 50%; box-shadow: 0 0 0 3px #58754512; }
  .analog h3 { font-size: clamp(2rem, 4vw, 3.3rem); }
  .analog .open-link { border-bottom: 1px solid #7f8876; margin-top: 16px; }
  .analog .transport { flex-direction: column-reverse; gap: 10px; }
  .analog .transport-label { display: block; font-size: .5rem; text-transform: uppercase; letter-spacing: .16em; }
  .analog .skip { width: 56px; height: 56px; border: 3px solid #d0cfc1; background: linear-gradient(#faf9ef, #d9d9cc); box-shadow: 0 2px 3px #433f3430, inset 0 0 0 1px #fff; }
  .analog .selectors { gap: 8px; border-top: 1px solid #c8c6b7; padding-top: 24px; }
  .analog .selector { flex: 1; gap: 9px; border: 1px solid #c4c4b5; border-radius: 4px; padding: 10px; background: linear-gradient(#f3f3e9, #deded0); box-shadow: 0 3px 0 #bfc0b1; min-height: 56px; }
  .analog .selector :global(img) { display: none; }
  .analog .selector-title { font-size: .65rem; }
  .analog .selector[aria-pressed='true'] { background: #3b4d40; color: #f4f4e8; border-color: #394a3d; box-shadow: 0 1px 0 #a4ac9a, inset 0 2px 5px #0004; transform: translateY(2px); }
  .analog .selector[aria-pressed='true'] .preset-number { color: #d1d9c8; }
  .analog .mock-footer { margin-top: 24px; }

  /* 02. An open editorial spread, with artwork treated as a printed object. */
  .editorial { padding: 30px 0 0; border-block: 1px solid var(--color-ink); }
  .editorial .collection-label { letter-spacing: .08em; }
  .editorial .feature { display: grid; grid-template-columns: minmax(0, 1fr) 38%; grid-template-areas: 'info art' 'controls art'; gap: 22px 9%; padding-block: 48px; }
  .editorial .art-stage { grid-area: art; padding: 28px; background: #e9eadd; }
  .editorial .cover { box-shadow: 4px 7px 0 #fff9, 12px 16px 25px -17px #27332e80; aspect-ratio: 1; }
  .editorial .information { grid-area: info; align-self: center; }
  .editorial h3 { font-size: clamp(2.8rem, 5.8vw, 4.6rem); margin-top: 25px; max-width: 9ch; }
  .editorial .open-link { border-bottom: 1px solid var(--color-ink); margin-top: 18px; }
  .editorial .transport { grid-area: controls; }
  .editorial .skip { width: 44px; height: 44px; border-radius: 0; border-color: var(--color-ink); }
  .editorial .selectors { gap: 24px; padding-block: 24px; border-top: 1px solid var(--color-line); }
  .editorial .selector { flex: 1; gap: 12px; position: relative; opacity: .65; padding-block: 6px; }
  .editorial .selector::before { content: ''; position: absolute; height: 2px; top: -25px; inset-inline: 0; background: transparent; }
  .editorial .selector[aria-pressed='true'], .editorial .selector:hover { opacity: 1; }
  .editorial .selector[aria-pressed='true']::before { background: var(--color-accent); }
  .editorial .selector .preset-number { display: none; }
  .editorial .selector-title { font-size: .6875rem; }
  .editorial .mock-footer { display: none; }

  /* 03. A cyclic cover fan. Its five real covers remain individually selectable. */
  .gallery { --local-muted: #b5bfae; --local-line: #4d584c; color: #f3f4e9; padding: 32px 32px 24px; border-radius: 10px; background: radial-gradient(ellipse at 50% 30%, #384537, #202c25 70%); overflow: hidden; }
  .gallery .mock-heading > p { font-size: 1.8rem; }
  .gallery .feature { display: grid; grid-template-columns: 1fr auto; gap: 0 24px; }
  .gallery .art-stage { --spread: 140px; height: 360px; grid-column: 1 / -1; margin: 6px -32px 0; overflow: clip; cursor: grab; }
  .gallery .art-stage:active { cursor: grabbing; }
  .gallery .cover { position: absolute; top: 65px; left: calc(50% - 125px); width: 250px; aspect-ratio: 1; border-radius: 5px; box-shadow: 0 18px 25px -5px #0008; transform-origin: center bottom; transform: translateX(calc(var(--offset) * var(--spread))) translateY(14px) rotate(calc(var(--offset) * 7deg)) scale(.85); z-index: var(--depth); transition: transform 400ms cubic-bezier(.22,.68,0,1), filter 250ms ease; filter: brightness(.65); }
  .gallery .cover :global(img) { border-radius: inherit; pointer-events: none; }
  .gallery .cover[aria-pressed='true'] { transform: translateX(0) translateY(-12px) rotate(0) scale(1); filter: brightness(1); }
  .gallery .cover:hover { filter: brightness(1); }
  .gallery .cover:focus-visible { outline-offset: -5px; outline-color: white; }
  .gallery .information { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 20px; }
  .gallery .show-label { font-size: .55rem; }
  .gallery h3 { font-size: 2.4rem; margin-top: 12px; }
  .gallery .open-link { color: #f6f7ed; margin: 0; border-bottom: 1px solid #9ba88e; white-space: nowrap; }
  .gallery .transport { align-self: end; }
  .gallery .skip:hover { background: #ffffff14; }
  .gallery .selector-area { display: none; }
  .gallery .mock-footer { margin-top: 28px; padding-top: 18px; border-top: 1px solid #485446; }

  /* 04. A compact two-pane library, with every show visible in the queue. */
  .playlist { padding: 28px; display: grid; grid-template-columns: .9fr 1.1fr; gap: 24px 36px; border: 1px solid #d5dccf; border-radius: 12px; background: #f1f3ed; }
  .playlist .mock-heading { grid-column: 1 / -1; padding-bottom: 20px; border-bottom: 1px solid #d5dccf; }
  .playlist .mock-heading > p { font-size: 1.8rem; }
  .playlist .feature { display: grid; grid-template-columns: 1fr auto; align-items: end; padding: 20px; background: #e2e8dc; border: 1px solid #d2dac9; border-radius: 8px; }
  .playlist .art-stage { grid-column: 1 / -1; width: min(100%, 200px); margin: 0 auto 26px; }
  .playlist .cover { aspect-ratio: 1; box-shadow: 0 10px 20px -12px #27332e90; border-radius: 5px; overflow: hidden; }
  .playlist .information { grid-column: 1 / -1; }
  .playlist .show-label { font-size: .5rem; justify-content: space-between; }
  .playlist h3 { font-size: 2rem; }
  .playlist [data-creator-display] { font-size: .75rem; }
  .playlist .open-link { margin-top: 20px; color: white; background: #3b594c; border-radius: 25px; padding: 6px 16px; font-size: .6875rem; }
  .playlist .transport { grid-column: 2; margin-top: -44px; gap: 8px; }
  .playlist .skip { width: 44px; height: 44px; background: #f5f7f0; border-color: #c3ceba; }
  .queue-heading { display: flex; justify-content: space-between; gap: 12px; padding: 10px 8px 18px; font-size: .625rem; color: var(--local-muted); text-transform: uppercase; letter-spacing: .08em; }
  .playlist .selectors { flex-direction: column; gap: 7px; }
  .playlist .selector { gap: 14px; border: 1px solid transparent; border-radius: 5px; padding: 12px; min-height: 74px; }
  .playlist .selector:hover { background: #e7ecdf; }
  .playlist .selector[aria-pressed='true'] { background: #fffef9; border-color: #d8dece; box-shadow: 0 3px 5px -4px #27332e40; }
  .playlist .selector :global(img) { border-radius: 3px; }
  .playlist .selector-text { flex: 1; }
  .playlist .selector-title { font-size: .8125rem; }
  .playlist .selector-creator { display: block; font-size: .625rem; color: var(--local-muted); margin-top: 4px; }
  .playlist .selector[aria-pressed='true'] .selection-mark { display: flex; }
  .playlist .mock-footer { grid-column: 1 / -1; padding-top: 18px; border-top: 1px solid #d5dccf; }

  @media (max-width: 850px) {
    .analog { padding: 24px; }
    .analog .feature { grid-template-columns: 180px minmax(0, 1fr); gap: 24px; }
    .analog .transport { flex-direction: row; grid-column: 1 / -1; justify-content: center; }
    .analog .transport-label { display: none; }
    .analog .skip { width: 48px; height: 48px; }
    .analog .selectors { gap: 6px; padding-top: 18px; }
    .analog .selector { flex-direction: column; text-align: center; gap: 4px; padding: 8px 4px; }
    .editorial .feature { gap: 24px 6%; }
    .editorial .art-stage { padding: 18px; align-self: center; }
    .editorial .selectors { gap: 14px; }
    .editorial .selector { flex-direction: column; align-items: start; gap: 10px; }
    .gallery .information { display: block; }
    .gallery .open-link { margin-top: 14px; }
    .gallery .art-stage { --spread: 105px; }
    .playlist { gap: 24px; padding: 24px; }
    .playlist .transport { grid-column: 1 / -1; margin-top: 16px; }
    .playlist .selector { padding: 10px 8px; gap: 10px; }
    .playlist .preset-number { display: none; }
  }
  @media (max-width: 640px) {
    .mock-heading { align-items: start; gap: 10px; flex-direction: column; }
    .mock-heading > p { font-size: 1.8rem; }
    .collection-label { font-size: .5rem; }
    .analog { border-width: 8px; padding: 20px 16px 14px; border-radius: 12px; }
    .analog .mock-heading { padding-bottom: 18px; }
    .analog .feature { grid-template-columns: 1fr; padding: 24px 0 20px; gap: 22px; }
    .analog .art-stage { width: 170px; margin-inline: auto; }
    .analog .information { text-align: center; }
    .analog .show-label { justify-content: center; font-size: .5rem; gap: 12px; }
    .analog h3 { font-size: 2.1rem; }
    .analog .open-link { margin-top: 8px; }
    .analog .selectors { gap: 3px; }
    .analog .selector { min-height: 48px; }
    .analog .selector-title { display: none; }
    .analog .preset-number { font-size: .75rem; }
    .analog .mock-footer { font-size: .5rem; margin-top: 20px; }
    .analog .loop-note { display: none; }
    .editorial { padding-top: 24px; }
    .editorial .feature { grid-template-columns: 1fr; grid-template-areas: 'art' 'info' 'controls'; padding-block: 28px; gap: 28px; }
    .editorial .art-stage { width: 100%; padding: 26px; }
    .editorial .cover { width: min(100%, 230px); margin-inline: auto; }
    .editorial h3 { max-width: 100%; font-size: 3rem; margin-top: 16px; }
    .editorial .open-link { margin-top: 10px; }
