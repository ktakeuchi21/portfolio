---
import ShelfRailMock from './ShelfRailMock.astro';
import { withBase } from '../../lib/site';
const ideas = [
  { id: 'overlap', number: '01', title: 'The overlapping ledge', note: 'Half a cover is enough to catch your eye. Hover over a book and its neighbors slide aside as the full cover lifts off the shelf.', trait: 'The closest halfway point', pick: true },
  { id: 'turn', number: '02', title: 'The turning shelf', note: 'Real covers, angled into a compact row. The book you choose turns toward you, like the podcast coverflow resting on a shelf.', trait: 'More depth and a darker mood' },
  { id: 'pocket', number: '03', title: 'The pocket shelf', note: 'The lower half of each book sits behind a wooden lip. Hover to pull a book up and see the full front cover.', trait: 'The most literal half-reveal' },
  { id: 'lean', number: '04', title: 'The leaning library', note: 'A closely packed row of familiar covers, leaning toward the middle. Your chosen book stands upright while the rest make room.', trait: 'The most compact collection' },
] as const;
---
<div class="page-width ledge-explorations">
  <header class="intro">
    <a class="back" href={withBase('/design/bookshelves/')}>← Back to the six bookshelf ideas</a>
    <p class="eyebrow">Design explorations / A closer look at the shelf</p>
    <h1>A little glimpse.<br /><em>A whole library.</em></h1>
    <p class="deck">Four ways to keep the real covers, the feeling of a shelf, and room for whatever you read next.</p>
    <div class="shared-details"><span>One horizontal row</span><span>Real cover artwork</span><span>Hover, focus, or tap to reveal</span></div>
    <nav aria-label="Shelf design options">{ideas.map(idea=><a href={`#${idea.id}`}><span>{idea.number}</span>{idea.title}</a>)}</nav>
  </header>
  {ideas.map(idea=><section class="idea" id={idea.id} aria-labelledby={`${idea.id}-heading`}>
    <div class="caption"><span>{idea.number}</span><h2 id={`${idea.id}-heading`}>{idea.title}</h2>{'pick' in idea && <span class="pick">My pick</span>}</div>
    <p class="description">{idea.note}</p>
    <ShelfRailMock variant={idea.id} />
    <p class="footnote">{idea.trait}<span>More books add length, never another row.</span></p>
  </section>)}
  <p class="end-note">All four browse the same favorites. Try scrolling, hovering over a partial cover, and using the arrows. On a phone, swipe through the shelf and tap a cover.</p>
</div>

<style>
  .ledge-explorations { max-width: 1080px; }
  .intro { padding-top: 32px; }
  .back { display: inline-flex; align-items: center; min-height: 44px; font-size: .8rem; color: var(--color-muted); margin-bottom: 30px; }
  .back:hover { text-decoration: underline; }
  .eyebrow { color: var(--color-muted); }
  h1 { font: 400 clamp(3rem,6.5vw,5rem)/1.06 var(--font-display); letter-spacing: -.04em; margin-top: 20px; }
  h1 em { color: var(--color-accent); }
  .deck { margin-top: 24px; color: var(--color-muted); max-width: 610px; }
  .shared-details { display: flex; flex-wrap: wrap; gap: 8px 22px; margin-top: 22px; font-size: .75rem; color: var(--color-accent); }
  nav { display: grid; grid-template-columns: repeat(4,1fr); gap: 24px; margin-top: 30px; }
  nav a { display: flex; align-items: center; gap: 12px; border-bottom: 1px solid var(--color-line); font-size: .8rem; min-height: 54px; }
  nav a:hover { border-color: var(--color-accent); }
  nav span { color: var(--color-muted); font-family: var(--font-display); }
  .idea { margin-top: 64px; scroll-margin-top: 32px; }
  .caption { display: flex; align-items: center; flex-wrap: wrap; gap: 16px; }
  .caption > span { font-size: .75rem; color: var(--color-muted); }
  h2 { font: 400 2rem/1.15 var(--font-display); letter-spacing: -.02em; }
  .caption .pick { padding: 3px 10px; border-radius: 20px; background: #e4eadf; color: var(--color-accent); font-size: .625rem; }
  .description { margin: 12px 0 26px; color: var(--color-muted); max-width: 730px; font-size: .875rem; }
  .footnote { display: flex; justify-content: space-between; gap: 16px; margin-top: 16px; color: var(--color-accent); font-size: .7rem; }
  .footnote span { color: var(--color-muted); }
  .end-note { margin-top: 54px; padding-top: 28px; border-top: 1px solid var(--color-line); color: var(--color-muted); font-size: .8rem; max-width: 760px; }
  @media (max-width: 640px) {
    nav { grid-template-columns: repeat(2,1fr); gap: 0 18px; }
    nav a { font-size: .72rem; gap: 8px; }
    .idea { margin-top: 44px; }
    .caption { gap: 10px; }
    h2 { font-size: 1.7rem; }
    .footnote { font-size: .65rem; }
    .footnote span { display: none; }
  }
</style>
