---
import HomePageContent from '../HomePageContent.astro';
import { homePalettes as originalPalettes, boldHomePalettes, referenceHomePalettes, warmHomePalettes, paletteCSS, type HomePalette } from '../../data/home-palettes';
import { withBase } from '../../lib/site';
interface Props { bold?: boolean; references?: boolean; warm?: boolean; }
const { bold = false, references = false, warm = false } = Astro.props;
const homePalettes: readonly HomePalette[] = warm ? warmHomePalettes : references ? referenceHomePalettes : bold ? boldHomePalettes : originalPalettes;
const themeCSS = `:root{${paletteCSS(homePalettes[0])}}` + homePalettes.map(palette => `:root[data-home-palette="${palette.id}"]{${paletteCSS(palette)}}`).join('\n');
const paletteIds = homePalettes.map(palette => palette.id);
---
<style is:inline set:html={themeCSS} />
<script is:inline define:vars={{ paletteIds }}>
  const requestedPalette = new URLSearchParams(location.search).get('palette');
  document.documentElement.dataset.homePalette = paletteIds.includes(requestedPalette) ? requestedPalette : paletteIds[0];
</script>
<noscript><style is:inline>.palette-picker { position: static !important; transform: none !important; margin: 20px auto; }.palette-options { display: none !important; }</style></noscript>
<aside class="palette-picker" aria-label="Homepage color exploration" data-palette-preview data-reference-prefix={warm ? 'Inspired by' : 'Reference'}>
  <div class="picker-heading">
    <div><span class="eyebrow">{warm ? 'Beyond blue & purple' : references ? 'Inspired by real websites' : bold ? 'Round two / More color' : 'Five color directions'}</span><p data-palette-note aria-live="polite">{homePalettes[0].mood}</p></div>
    <div class="picker-links">
      {references || warm ? <a data-palette-reference href={homePalettes[0].reference!.url} target="_blank" rel="noopener noreferrer"><span data-reference-label>{warm ? 'Inspired by' : 'Reference'}: {homePalettes[0].reference!.name}</span> <span aria-hidden="true">↗</span></a> : <a href={withBase('/design/home-colors-warm/')}>Newest palettes <span aria-hidden="true">↗</span></a>}
      {references && <a href={withBase('/design/home-colors-warm/')}>Newest palettes <span aria-hidden="true">↗</span></a>}
      <a href={withBase('/')}>Current homepage <span aria-hidden="true">↗</span></a>
    </div>
  </div>
  <div class="palette-options" role="toolbar" aria-label="Choose a homepage color palette">
    {homePalettes.map((palette, index) => <button type="button" data-palette={palette.id} data-mood={palette.mood} data-paper={palette.paper} data-reference-name={palette.reference?.name} data-reference-url={palette.reference?.url} aria-pressed={index === 0 ? 'true' : 'false'} style={`--option-paper:${palette.paper};--option-ink:${palette.ink};--option-line:${palette.line};color-scheme:${palette.scheme}`}>
      <span class="option-swatches" aria-hidden="true">{(palette.swatches ?? [palette.paper, palette.wash, palette.accent, palette.ink]).map(color => <i style={`background:${color}`} />)}</span>
      <span class="option-name"><small>0{index + 1}</small>{palette.name}<span class="selected-mark" aria-hidden="true">✓</span></span>
    </button>)}
  </div>
  <noscript><p class="no-script-note">Enable JavaScript to switch palettes. {homePalettes[0].name} is shown below.</p></noscript>
</aside>
<HomePageContent />

<script>
  const picker = document.querySelector<HTMLElement>('[data-palette-preview]');
  if (picker) {
    const buttons = [...picker.querySelectorAll<HTMLButtonElement>('[data-palette]')];
    const note = picker.querySelector<HTMLElement>('[data-palette-note]')!;
    const reference = picker.querySelector<HTMLAnchorElement>('[data-palette-reference]');
    const choose = (button: HTMLButtonElement, updateURL = true) => {
      document.documentElement.dataset.homePalette = button.dataset.palette;
      buttons.forEach(item => {
        item.setAttribute('aria-pressed', String(item === button));
        item.tabIndex = item === button ? 0 : -1;
      });
      note.textContent = button.dataset.mood!;
      if (reference && button.dataset.referenceUrl) {
        reference.href = button.dataset.referenceUrl;
        reference.querySelector('[data-reference-label]')!.textContent = `${picker.dataset.referencePrefix}: ${button.dataset.referenceName}`;
      }
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', button.dataset.paper!);
      if (updateURL) {
        const url = new URL(location.href);
        url.searchParams.set('palette', button.dataset.palette!);
        history.replaceState(history.state, '', url);
      }
    };
    buttons.forEach((button, index) => {
      button.addEventListener('click', () => choose(button));
      button.addEventListener('keydown', event => {
        let next: number;
        if (event.key === 'ArrowRight') next = (index + 1) % buttons.length;
        else if (event.key === 'ArrowLeft') next = (index + buttons.length - 1) % buttons.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = buttons.length - 1;
        else return;
        event.preventDefault();
        choose(buttons[next]);
        buttons[next].focus({ preventScroll: true });
        buttons[next].scrollIntoView({ block: 'nearest', inline: 'center' });
      });
    });
    const restore = () => {
      const id = new URL(location.href).searchParams.get('palette');
      const selected = buttons.find(button => button.dataset.palette === id) ?? buttons[0];
      choose(selected, false);
      // Keep a directly linked choice visible in the mobile horizontal selector.
      requestAnimationFrame(() => selected.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'instant' }));
    };
    restore();
    window.addEventListener('popstate', restore);
    new ResizeObserver(() => document.documentElement.style.setProperty('--palette-picker-height', `${picker.offsetHeight}px`)).observe(picker);
  }
</script>

<style is:global>
  html[data-home-palette] body { padding-bottom: calc(var(--palette-picker-height, 180px) + 40px); }
  html[data-home-palette] :is(a, button, [tabindex]) { scroll-margin-bottom: calc(var(--palette-picker-height, 180px) + 32px); }
  html[data-home-palette] ::selection { background: var(--color-accent); color: var(--color-on-accent); }
  html[data-home-palette] .home-hero h1 em { color: var(--color-heading-accent); }
  html[data-home-palette] .link-button--solid { background: var(--color-button); border-color: var(--color-button); color: var(--color-on-button); }
  html[data-home-palette] [data-home-motion] .project-preview-cue { color: var(--color-on-accent); }
  html[data-home-palette] .link-button--solid:hover { background: var(--color-button-hover); border-color: var(--color-button-hover); }
  html[data-home-palette] .skip-link { color: var(--color-paper); }
  html[data-home-palette] .project-image { background: var(--color-wash); }
  html[data-home-palette] .architecture-node { border-color: var(--color-line); }

  /* Reference studies change the role and amount of color, not the content. */
  html[data-home-palette="oura"] .hero-note { --color-muted: #56534C; background: #CED4B8; border: 0; padding: 18px 22px; }
  html[data-home-palette="oura"] .hero-note p { margin-bottom: 0; }
  html[data-home-palette="pentagram"] .identity-mark,
  html[data-home-palette="pentagram"] .work-concepts,
  html[data-home-palette="linear"] .identity-mark,
  html[data-home-palette="linear"] .work-concepts { color: var(--color-ink); }
  html[data-home-palette="pentagram"] .hero-flourish { color: var(--color-accent); opacity: 1; }
  html[data-home-palette="linear"] .hero-flourish { color: var(--color-muted); opacity: .5; }
  html[data-home-palette="apple"] .home-hero {
    --color-paper: #000000;
    --color-ink: #F5F5F7;
    --color-muted: #B9B9C1;
    --color-accent: #2997FF;
    --color-on-accent: #000000;
    --color-heading-accent: #F5F5F7;
    --color-line: #424245;
    position: relative;
    isolation: isolate;
    color: var(--color-ink);
    padding-bottom: 42px;
  }
  html[data-home-palette="apple"] .home-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: #000000;
    box-shadow: 0 0 0 100vmax #000000;
    clip-path: inset(0 -100vmax);
  }
  html[data-home-palette="apple"] .hero-flourish { color: #86868B; }
  html[data-home-palette="stripe"] .home-hero { position: relative; isolation: isolate; }
  html[data-home-palette="stripe"] .home-hero::before {
    content: '';
    position: absolute;
    z-index: -1;
    pointer-events: none;
    inset: 0 -20px -28px 32%;
    background: linear-gradient(135deg, #FFFFFF 6%, #E3ECFF 36%, #E6DAFC 55%, #FBE0EB 77%, #FFEDD2 100%);
    clip-path: polygon(28% 0, 100% 0, 100% 100%, 92% 100%);
  }
  html[data-home-palette="stripe"] .hero-note { position: relative; }

  /* Warm study: use color in distinct areas, keeping the same page structure. */
  html[data-home-palette="espresso"] .hero-note {
    --color-muted: #594B3F;
    background: #D8BE9D;
    border: 0;
    padding: 18px 22px;
  }
  html[data-home-palette="vermilion"] :is(.identity-mark, .work-concepts),
  html[data-home-palette="ochre"] :is(.identity-mark, .work-concepts),
  html[data-home-palette="cocoa"] :is(.identity-mark, .work-concepts) { color: var(--color-ink); }
  html[data-home-palette="vermilion"] .hero-flourish { color: var(--color-accent); opacity: 1; }
  html[data-home-palette="ochre"] .hero-note {
    --color-muted: #61532C;
    background: #F4E5AF;
    border: 0;
    padding: 18px 22px;
  }
  html[data-home-palette="ochre"] .hero-flourish { color: #BD951F; opacity: 1; }
  html[data-home-palette="cocoa"] .hero-note {
    --color-muted: #5C4135;
    color: #29211D;
    background: #E6B7A5;
    border: 0;
    padding: 18px 22px;
  }
  html:is([data-home-palette="espresso"], [data-home-palette="ochre"], [data-home-palette="cocoa"]) .hero-note p { margin-bottom: 0; }
  @media (max-width: 640px) {
    html[data-home-palette="oura"] .hero-note { padding: 14px 16px; }
    html[data-home-palette="stripe"] .home-hero::before { inset: 0 -12px 0 30%; opacity: .65; }
    html:is([data-home-palette="espresso"], [data-home-palette="ochre"], [data-home-palette="cocoa"]) .hero-note { padding: 14px 16px; }
  }
</style>

<style>
  .palette-picker { position: fixed; z-index: 30; bottom: 20px; left: 50%; transform: translateX(-50%); width: min(1120px, calc(100% - 40px)); padding: 18px 20px 16px; background: var(--color-paper); color: var(--color-ink); border: 1px solid var(--color-line); border-radius: 12px; box-shadow: 0 8px 50px #0002; }
  .picker-heading { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-bottom: 14px; }
  .picker-heading .eyebrow { font-size: .65rem; color: var(--color-accent); }
  .picker-heading p { font-size: .8125rem; line-height: 1.4; margin-top: 2px; }
  .picker-links { display: flex; gap: 20px; flex-shrink: 0; }
  .picker-heading a { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; font-size: .75rem; white-space: nowrap; text-decoration: underline; }
  .palette-options { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; }
  .palette-options button { display: block; padding: 0; min-width: 0; border: 1px solid var(--option-line); border-radius: 5px; background: var(--option-paper); color: var(--option-ink); cursor: pointer; text-align: left; }
  .palette-options button[aria-pressed="true"] { outline: 2px solid var(--color-accent); outline-offset: 3px; }
  .palette-options button:focus-visible { outline: 3px dashed var(--color-ink); outline-offset: 5px; }
  .option-swatches { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; height: 22px; overflow: hidden; border-radius: 4px 4px 0 0; border-bottom: 1px solid var(--option-line); }
  .option-name { display: flex; align-items: center; gap: 7px; min-height: 38px; padding: 8px; font-size: .6875rem; line-height: 1.3; font-weight: 550; color: var(--option-ink); }
  .option-name small { font-size: .5625rem; }
  .selected-mark { margin-left: auto; visibility: hidden; }
  [aria-pressed="true"] .selected-mark { visibility: visible; }
  .no-script-note { margin-top: 10px; font-size: .75rem; }
  @media (max-width: 780px) {
    .palette-picker { bottom: 10px; width: calc(100% - 20px); padding: 12px 14px; }
    .picker-heading { gap: 12px; margin-bottom: 8px; }
    .picker-heading p { max-width: 34ch; font-size: .75rem; }
    .picker-heading a { font-size: .6875rem; white-space: normal; text-align: right; line-height: 1.4; }
    .picker-links { flex-direction: column; gap: 0; }
    .picker-links a { justify-content: flex-end; }
    .palette-options { display: flex; overflow-x: auto; gap: 12px; padding: 7px; margin: -7px; scroll-snap-type: x proximity; }
    .palette-options button { flex: 0 0 180px; scroll-snap-align: center; }
    .option-name { font-size: .75rem; }
  }
</style>
