---
import type { CollectionEntry } from 'astro:content';
import LinkButton from './LinkButton.astro';
import ExternalLink from './ExternalLink.astro';
import { caseStudyPath } from '../lib/content';
import { withBase } from '../lib/site';
interface Props { entry: CollectionEntry<'work'>; index: number; headingLevel?: 'h2' | 'h3'; }
const { entry, index, headingLevel: Heading = 'h3' } = Astro.props;
const { title, summary, organization, role, tags, website } = entry.data;
const href = caseStudyPath(entry);
const titleHref = href || website;
---
<article class="work-card">
  <span class="work-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
  <div class="work-name"><p class="eyebrow">{organization}</p><Heading class="card-title">{titleHref ? <a href={withBase(titleHref)}>{title}</a> : title}</Heading><p class="work-role">{role}</p></div>
  <div class="work-summary">
    <p>{summary}</p>
    <div class="work-concepts">{tags.join(' · ')}</div>
    {href || website ? <div class="work-actions">
      {href && <LinkButton href={href} external={href.startsWith('https:')}>Read case study</LinkButton>}
      {website && <ExternalLink href={website}>Visit website</ExternalLink>}
    </div> : <span class="forthcoming">Case study forthcoming</span>}
  </div>
</article>
