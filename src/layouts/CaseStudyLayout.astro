---
import type { CollectionEntry } from 'astro:content';
import SiteLayout from './SiteLayout.astro';
import ExternalLink from '../components/ExternalLink.astro';
import { withBase } from '../lib/site';
interface Props { entry: CollectionEntry<'projects'> | CollectionEntry<'work'>; }
const { entry } = Astro.props;
const { title, summary, image, liveDemo, github, tags } = entry.data;
const personal = entry.data.type === 'personal';
const contextLabel = entry.data.type === 'personal' ? entry.data.label : entry.data.organization;
const context = entry.data.type === 'personal' ? 'Independent personal project' : entry.data.organization;
const role = entry.data.type === 'personal' ? 'Product framing & prototyping' : entry.data.role;
---
<SiteLayout title={title} description={summary}>
  <article class="page-width">
    <a class="case-back" href={withBase(`/${entry.collection}/`)}>← Back to {personal ? 'projects' : 'work'}</a>
    <header class="page-intro case-intro"><p class="eyebrow">{contextLabel}</p><h1>{title}</h1><p>{summary}</p>
      <dl class="case-facts"><div><dt>Context</dt><dd>{context}</dd></div><div><dt>Role</dt><dd>{role}</dd></div><div><dt>Focus</dt><dd>{tags.join(' · ')}</dd></div></dl>
    </header>
    {image && <figure><div class="case-cover"><img src={withBase(image.src)} alt={image.alt} width={image.width} height={image.height} fetchpriority="high" /></div>{image.caption && <figcaption class="case-caption">{image.caption}</figcaption>}</figure>}
    <div class="case-body"><div class="prose"><slot /></div><nav class="case-end" aria-label="Explore this project">{liveDemo && <ExternalLink href={liveDemo}>Open live demo</ExternalLink>}{github && <ExternalLink href={github}>View GitHub repository</ExternalLink>}</nav></div>
  </article>
</SiteLayout>
