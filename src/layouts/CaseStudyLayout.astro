---
import type { CollectionEntry } from 'astro:content';
import SiteLayout from './SiteLayout.astro';
import ExternalLink from '../components/ExternalLink.astro';
import { withBase } from '../lib/site';
import { projectCategories, projectOwnershipLabel, projectStatuses } from '../lib/content';
interface Props { entry: CollectionEntry<'projects'> | CollectionEntry<'work'>; }
const { entry } = Astro.props;
const { title, summary, image, liveDemo, github, tags } = entry.data;
const project = entry.collection === 'projects' ? entry : undefined;
const projectCategory = project ? projectCategories.find(category => category.id === project.data.category)! : undefined;
const contextLabel = projectCategory ? `${projectCategory.title} · ${projectOwnershipLabel}` : entry.collection === 'work' ? entry.data.organization : '';
const hasExternalLinks = liveDemo || github;
---
<SiteLayout title={title} description={summary}>
  <article class="page-width">
    <a class="case-back" href={withBase(project ? `/projects/#${project.data.category}` : '/work/')}>← Back to {projectCategory ? projectCategory.title : 'work'}</a>
    <header class="page-intro case-intro"><p class="eyebrow">{contextLabel}</p><h1>{title}</h1><p>{summary}</p>
      <dl class="case-facts">
        <div><dt>My role</dt><dd>{entry.data.role}</dd></div>
        <div><dt>{project ? 'Designed for' : 'Context'}</dt><dd>{project ? project.data.audience : entry.collection === 'work' ? entry.data.organization : ''}</dd></div>
        <div><dt>{project ? 'Current status' : 'Focus'}</dt><dd>{project ? projectStatuses[project.data.status] : tags.join(' · ')}</dd></div>
      </dl>
      {hasExternalLinks && <nav class="case-links" aria-label="Explore this project">{liveDemo && <ExternalLink href={liveDemo}>{entry.data.slug === 'what-i-made' ? 'Explore public sample' : 'Open live demo'}</ExternalLink>}{github && <ExternalLink href={github}>View source</ExternalLink>}</nav>}
    </header>
    {image && <figure><div class="case-cover"><img src={withBase(image.src)} alt={image.alt} width={image.width} height={image.height} fetchpriority="high" /></div>{image.caption && <figcaption class="case-caption">{image.caption}</figcaption>}</figure>}
    <div class="case-body"><div class="prose"><slot /></div><nav class="case-end" aria-label="More projects"><a class="link-button" href={withBase(project ? `/projects/#${project.data.category}` : '/work/')}>← {projectCategory ? `More ${projectCategory.title.toLowerCase()} projects` : 'More professional work'}</a></nav></div>
  </article>
</SiteLayout>
