---
import '../styles/global.css';
import '../styles/project-transitions.css';
import studioStyles from '../styles/studio.css?url';
import Header from '../components/Header.astro';
import StudioHeroMotion from '../components/StudioHeroMotion.astro';
import StudioModeScript from '../components/StudioModeScript.astro';
import StudioScrollMotion from '../components/StudioScrollMotion.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import ProjectTransitions from '../components/ProjectTransitions.astro';
import { profile, withBase } from '../lib/site';
interface Props { title?: string; description?: string; noindex?: boolean; homePalette?: string; }
const { title, description = 'Kai Takeuchi builds healthcare and AI products around complex workflows, enterprise data, and human decision-making.', noindex = false, homePalette } = Astro.props;
const studioTheme = !homePalette && !Astro.url.pathname.startsWith(withBase('/design/'));
const studioHome = studioTheme && Astro.url.pathname === withBase('/');
const pageTitle = title ? `${title} | ${profile.name}` : `${profile.name} | ${profile.positioning}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const socialImage = new URL(withBase('/images/social-preview-studio.png'), Astro.site ?? Astro.url.origin);
const socialImageAlt = `${profile.name}, ${profile.positioning}, beside a photo of a stairway along a mountain ridge.`;
---
<!doctype html>
<html lang="en" data-home-palette={homePalette} data-portfolio-theme={studioTheme ? 'studio' : undefined} data-studio-home={studioHome ? '' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ProjectTransitions />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={studioTheme ? (studioHome ? '#273031' : '#f1eee6') : '#faf8f0'} />
    {studioTheme && <StudioModeScript home={studioHome} />}
    {studioHome && <StudioHeroMotion />}
    {studioTheme && <link rel="stylesheet" href={studioStyles} />}
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <Analytics disabled={noindex} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header studioTheme={studioTheme} />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
    {studioTheme && <StudioScrollMotion />}
  </body>
</html>
